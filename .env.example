# Copy to .env for local development. On Vercel, set these in Project Settings → Environment Variables.

# Neon pooled connection string (or local Postgres for dev)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Random 32+ char secret. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# The public URL of the app (no trailing slash). Used in email links.
APP_URL="http://localhost:3000"

# console | gmail
#   console: emails are recorded in the in-app outbox but not sent (safe for dev)
#   gmail:   send through your Gmail via SMTP (requires an App Password, see SETUP.md)
EMAIL_TRANSPORT="console"
GMAIL_USER="you@gmail.com"
GMAIL_APP_PASSWORD=""

# Shared secret for /api/cron/tick (reminders + email queue). Generate like AUTH_SECRET.
CRON_SECRET=""

# The manager's account, created/updated by `npm run db:seed`
MANAGER_EMAIL="you@gmail.com"
MANAGER_NAME="Your Name"

# Show the /admin/dev time-travel panel (set "false" once real volunteers are using the app)
ENABLE_TIME_TRAVEL="true"
